# Copy to .env and adjust for your machine:
#   cp .env.example .env

# PostgreSQL (Category A)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dropgate_dev"

# API (Category B+)
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth (Category B+)
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d

# Redis (Category F) — OPTIONAL. If unset or unreachable, the API runs degraded
# (no cache, rate limits fail-open). Start one with:
#   docker run -p 6379:6379 redis:7
REDIS_URL="redis://localhost:6379"

# How long the public drop page stays cached (seconds). Short = fresher stock.
DROP_CACHE_TTL_SECONDS=10

# Fixed-window rate limits: max requests per window (seconds)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_JOIN_MAX=20
RATE_LIMIT_JOIN_WINDOW=60
